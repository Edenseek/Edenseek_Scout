{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scout report index (v1)",
  "type": "object",
  "required": ["report_index_version", "count", "entries"],
  "properties": {
    "report_index_version": {"type": "string"},
    "count": {"type": "integer"},
    "latest": {"type": ["object", "null"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["report_id", "run_id", "run_seq", "completed_at",
                     "geometry_comparability_key", "metadata_comparability_key",
                     "persisted_key", "report_sha256"],
        "properties": {
          "report_id": {"type": "string"}, "run_id": {"type": "string"},
          "run_seq": {"type": "integer"},
          "event_time": {"type": ["string", "null"]},
          "measurement_time": {"type": ["string", "null"]},
          "metrics": {"type": "object"},
          "geometry_benchmark": {"type": "object"},
          "metadata_benchmark": {"type": "object"},
          "geometry_comparability_key": {"type": "string"},
          "metadata_comparability_key": {"type": "string"},
          "report_sha256": {"type": ["string", "null"]}
        }
      }
    }
  }
}
